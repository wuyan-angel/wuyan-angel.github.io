<% var first = page.posts.sort("date", "desc").eq(0); %>
<div id="screen">
    <div id="mark">
        <div class="layer" data-depth="0.4">
            <%- image_tag(theme.welcome_cover || first.cover || "/img/welcome-cover.jpg", {id: "cover", crossorigin: "anonymous", width: 1920, height: 1080}) %>
        </div>
    </div>
    <div id="vibrant">
        <svg viewbox="0 0 2880 1620" height="100%" preserveaspectratio="xMaxYMax slice">
            <polygon opacity="0.7" points="2000,1620 0,1620 0,0 600,0 "/>
        </svg>
        <div></div>
    </div>
    <div id="header">
        <div>
            <% if (theme.logo_text) { %><a class="text-logo" href="/"><%= theme.logo_text %></a><% } else { %><a class="image-logo" href="/"></a><% } %>
			<% if (theme.local_search.enable){ %>
			<div class="iconfont icon-search switchsearch" href="<%= url_for('/search/') %>" title="搜索"></div>
			<%}%>
            <div class="iconfont icon-menu switchmenu"></div>
        </div>
    </div>
    <!-- 首屏：打字机金句（替代原来的"最新文章"） -->
    <div id="screen-quote">
        <span class="typed" id="screen-typed"></span>
    </div>
    <script>
    window.addEventListener('load', function () {
        var el = document.getElementById('screen-typed');
        if (!el || typeof Typed === 'undefined') return;
        var quotes = <%- JSON.stringify(theme.screen_quote || []) %>;
        if (!quotes.length) return;
        new Typed('#screen-typed', {
            strings: quotes,
            typeSpeed: 80,
            startDelay: 1000,
            backSpeed: 30,
            backDelay: 3000,
            loop: quotes.length > 1,
            showCursor: true,
            cursorChar: '▍'
        });
    });
    </script>
</div>
